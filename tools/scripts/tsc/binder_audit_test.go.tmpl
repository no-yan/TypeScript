func (r *auditRecorder) snapshot(name string) auditSnapshot {
    result := auditSnapshot{Schema: 2, Fixture: name, Visits: append([]string{}, r.visits...), SymbolCount: int(r.file.SymbolCount)}
    symbols := []*ast.Symbol{}
    symbolIDs := map[*ast.Symbol]int{}
    sid := func(s *ast.Symbol) int {
        if s == nil { return 0 }
        if id := symbolIDs[s]; id != 0 { return id }
        id := len(symbols)+1; symbolIDs[s] = id; symbols = append(symbols, s); return id
    }
    table := func(tab ast.SymbolTable) []auditEntry {
        keys := make([]string, 0, len(tab)); for key := range tab { keys = append(keys, key) }; sort.Strings(keys)
        rows := make([]auditEntry, 0, len(keys))
        for _, key := range keys { rows = append(rows, auditEntry{key, sid(tab[key])}) }; return rows
    }
    flowIDs := map[*ast.FlowNode]int{}
    for i, flow := range r.flows {
        if flowIDs[flow] != 0 { r.t.Fatal("duplicate flow allocation identity") }
        flowIDs[flow] = i+1
    }
    fid := func(flow *ast.FlowNode) int {
        if flow == nil { return 0 }
        id := flowIDs[flow]; if id == 0 { r.t.Fatal("Flow reference outside allocation census") }; return id
    }
    flowList := func(list *ast.FlowList) []int {
        rows := []int{}; seen := map[*ast.FlowList]bool{}
        for ; list != nil; list = list.Next {
            if seen[list] { r.t.Fatal("cycle in FlowList") }; seen[list] = true
            rows = append(rows, fid(list.Flow))
        }; return rows
    }
    for _, n := range r.nodes {
        children := []string{}; for _, child := range r.children[n] { children = append(children, r.key(child)) }
        row := auditNodeRow{Key:r.key(n), Kind:auditKind(n).String(), Pos:auditPos(n), End:auditEnd(n), BeforeFlags:r.before[n], Flags:auditFlags(n), Children:children, Parent:r.key(auditParent(n)), Symbol:sid(n.Symbol()), LocalSymbol:sid(n.LocalSymbol()), Locals:table(n.Locals()), Flow:fid(auditFlow(n)), EndFlow:fid(auditEndFlow(n)), ReturnFlow:fid(auditReturnFlow(n)), FallthroughFlow:fid(auditFallthroughFlow(n)), NextContainer:r.key(auditNextContainer(n))}
        result.Nodes = append(result.Nodes, row)
    }
    result.FileSymbol = sid(r.file.Symbol)
    for i:=0; i<len(symbols); i++ {
        s:=symbols[i]; declarations:=[]string{}; for _, d:=range s.Declarations { declarations=append(declarations,r.key(d)) }
        result.Symbols=append(result.Symbols,auditSymbolRow{ID:i+1,Name:s.Name,Flags:s.Flags,CheckFlags:s.CheckFlags,Parent:sid(s.Parent),ExportSymbol:sid(s.ExportSymbol),ValueDeclaration:r.key(s.ValueDeclaration),Declarations:declarations,Members:table(s.Members),Exports:table(s.Exports)})
    }
    for i, f := range r.flows {
        row:=auditFlowRow{ID:i+1,Flags:f.Flags,Antecedent:fid(f.Antecedent),Antecedents:flowList(f.Antecedents)}
        switch {
        case f.Flags&ast.FlowFlagsSwitchClause!=0:
            d:=auditFlowData(f).AsFlowSwitchClauseData();row.SwitchStatement=r.key(d.SwitchStatement);row.ClauseStart=d.ClauseStart;row.ClauseEnd=d.ClauseEnd
        case f.Flags&ast.FlowFlagsReduceLabel!=0:
            d:=auditFlowData(f).AsFlowReduceLabelData();row.Target=fid(d.Target);row.ReduceAntecedents=flowList(d.Antecedents)
        default:row.Node=r.key(f.Node)
        }
        result.Flows=append(result.Flows,row)
    }
    var diagnostic func(*ast.Diagnostic)
    diagnostic=func(d *ast.Diagnostic) {
        result.Diagnostics=append(result.Diagnostics,fmt.Sprintf("%d:%d:%d:%d:%q:%q:%q",d.Code(),d.Category(),d.Loc().Pos(),d.Loc().End(),d.MessageKey(),d.MessageText(),d.MessageArgs()))
        for _, c:=range d.MessageChain() { diagnostic(c) }
        result.Diagnostics=append(result.Diagnostics,"related")
        for _, related:=range d.RelatedInformation() { diagnostic(related) }
        result.Diagnostics=append(result.Diagnostics,"end")
    }
    for _, d:=range r.file.BindDiagnostics() { diagnostic(d) }
    return result
}
func TestFoundationSemanticAudit(t *testing.T) {
    input,err:=os.ReadFile(os.Getenv("BINDER_AUDIT_FIXTURES"));if err!=nil {t.Fatal(err)}
    var fixtures []auditFixture;if err:=json.Unmarshal(input,&fixtures);err!=nil {t.Fatal(err)}
    if len(fixtures)==0 {t.Fatal("no audit fixtures")}
    for _,fixture:=range fixtures { t.Run(fixture.Name,func(t *testing.T) {
        script:=core.ScriptKindTS
        switch fixture.Script { case "JS":script=core.ScriptKindJS;case "TSX":script=core.ScriptKindTSX;case "JSON":script=core.ScriptKindJSON }
        sf:=parser.ParseSourceFile(ast.SourceFileParseOptions{FileName:fixture.File,Path:tspath.Path(fixture.File)},fixture.Source,script)
        defer auditRelease(sf)
        if !auditLocal(sf) {t.Fatal("parse Store contains foreign child/list references")}
        r:=&auditRecorder{t:t,file:sf,keys:map[auditNode]string{},before:map[auditNode]ast.NodeFlags{},children:map[auditNode][]auditNode{}}
        r.census(auditRoot(sf),fixture.File)
        foundationAudit=r
        defer func(){foundationAudit=nil}()
        BindSourceFile(sf)
        foundationAudit=nil
        actual:=r.snapshot(fixture.Name)
        // Binding again must be a no-op, including all attachment and symbol identities.
        BindSourceFile(sf)
        if again:=r.snapshot(fixture.Name);!reflect.DeepEqual(actual,again) {t.Fatal("second BindSourceFile changed semantic snapshot")}
        data,err:=json.MarshalIndent(actual,"","  ");if err!=nil {t.Fatal(err)}
        dest:=os.Getenv("BINDER_AUDIT_OUT");if dest=="" {t.Fatal("BINDER_AUDIT_OUT required")}
        if err:=os.MkdirAll(dest,0755);err!=nil {t.Fatal(err)}
        if err:=os.WriteFile(filepath.Join(dest,fixture.Name+".json"),append(data,'\n'),0644);err!=nil {t.Fatal(err)}
        auditMutationChecks(t,r,actual)
    }) }
}

