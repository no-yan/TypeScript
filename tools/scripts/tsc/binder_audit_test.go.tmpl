func (r *auditRecorder) key(n auditNode) string {
    if auditNil(n) { return "" }
    if key, ok := r.keys[n]; ok { return key }
    r.t.Fatalf("AST reference outside syntax census: kind=%v span=%d:%d", auditKind(n), auditPos(n), auditEnd(n))
    return ""
}
func (r *auditRecorder) census(n auditNode, key string) {
    if auditNil(n) { return }
    if _, ok := r.keys[n]; ok { return }
    r.keys[n] = key
    r.nodes = append(r.nodes, n)
    r.before[n] = auditFlags(n)
    n.ForEachChild(func(child auditNode) bool {
        if !auditNil(child) {
            i := len(r.children[n])
            r.children[n] = append(r.children[n], child)
            r.census(child, fmt.Sprintf("%s/c%d", key, i))
        }
        return false
    })
    // Inspect only parse-time JSDoc; do not trigger lazy parsing for observation.
    for i, doc := range n.EagerJSDoc(r.file) { r.census(doc, fmt.Sprintf("%s/j%d", key, i)) }
}
func (r *auditRecorder) visit(n auditNode) {
    if !auditNil(n) { r.visits = append(r.visits, r.key(n)) }
}

